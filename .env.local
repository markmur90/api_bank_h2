# ===========================================
# CONFIGURACIÓN GENERAL DEL PROYECTO
# ===========================================

# Nombre del proyecto principal
PROJECT_NAME=api_bank_h2
PROJECT_NAME_SOCK=api

# Entorno de ejecución (local | production | heroku)
# ENVIRONMENT=local
# DJANGO_ENV=local
# Puerto local para desarrollo (livereload, debug)
PORT=8000

# Interfaz de red para diagnóstico/red (ej. wlan0 o eth0)
INTERFAZ=wlan0

# Ruta raíz del proyecto local
PROJECT_ROOT=/home/markmur88/api_bank_h2

# Entorno virtual Python
VENV_DIR=/home/markmur88/envSIM
VENV_PATH=/home/markmur88/envSIM

# Carpeta para backups locales
BACKUP_DIR=/home/markmur88/backup

# Logs generales
PROJECT_ROOT=/home/markmur88/api_bank_h2
LOG_DIR=/home/markmur88/api_bank_h2/scripts/schemas/logs
LOG_FILE_SCRIPT=/home/markmur88/api_bank_h2/scripts/schemas/logs/full_deploy.log
STARTUP_LOG=/home/markmur88/api_bank_h2/scripts/schemas/logs/startup.log
ERROR_LOG=/home/markmur88/api_bank_h2/scripts/schemas/logs/error.log
RUNNER_LOG=/home/markmur88/api_bank_h2/scripts/schemas/logs/runner.log
CRON_LOG=/home/markmur88/api_bank_h2/scripts/schemas/logs/cron.log
OPERATION_LOG=/home/markmur88/api_bank_h2/scripts/schemas/logs/operation.log
RED_LOG=/home/markmur88/api_bank_h2/scripts/schemas/logs/red.log

# Archivos auxiliares de red/cache
CACHE_DIR=/home/markmur88/api_bank_h2/tmp
IP_ANT=/home/markmur88/api_bank_h2/tmp/ip_antes.txt
IP_ACT=/home/markmur88/api_bank_h2/tmp/ip_actual.txt
MC_ANT=/home/markmur88/api_bank_h2/tmp/mac_antes.txt
MC_ACT=/home/markmur88/api_bank_h2/tmp/mac_actual.txt

# Scripts y servicios
SCRIPTS_DIR=/home/markmur88/api_bank_h2/scripts
SERVERS_DIR=/home/markmur88/api_bank_h2/servers

# Gunicorn config
GUNICORN_DIR=/home/markmur88/api_bank_h2/servers/gunicorn
SOCK_FILE=/home/markmur88/api_bank_h2/servers/gunicorn/api.sock
GUNICORN_LOG=/home/markmur88/api_bank_h2/servers/gunicorn/gunicorn.log
PIDFILE=/home/markmur88/api_bank_h2/scripts/schemas/logs/gunicorn.pid

# Supervisor config (opcional)
SUPERVISOR_DIR=/home/markmur88/api_bank_h2/servers/supervisor/conf.d
SUPERVISOR_PROGRAM=api_bank_h2_gunicorn
SUPERVISOR_CONF=/home/markmur88/api_bank_h2/servers/supervisor/conf.d/api_bank_h2_gunicorn.conf
OLD_SUPERVISOR_CONF=/home/markmur88/api_bank_h2/servers/supervisor/conf.d/api_bank_h2.conf

# Nginx local
NGINX_SITES_AVAILABLE=/home/markmur88/api_bank_h2/servers/nginx/sites-available
NGINX_SITES_ENABLED=/home/markmur88/api_bank_h2/servers/nginx/sites-enabled
NGINX_CONF=/home/markmur88/api_bank_h2/servers/nginx/sites-available/api_bank_h2

# SSL locales (si usás claves autogeneradas o propias)
CERT_DIR=/home/markmur88/api_bank_h2/servers/ssl/api_bank_h2
SSL_CERT=/home/markmur88/api_bank_h2/servers/ssl/api_bank_h2/ghost.crt
SSL_KEY=/home/markmur88/api_bank_h2/servers/ssl/api_bank_h2/ghost.key

# Hosts válidos permitidos por Django
ALLOWED_HOSTS=api.coretransapi.com,127.0.0.1,0.0.0.0

# Tor config (solo si usás navegador con proxy)
